{
    "name": "hagiang-backend",
    "version": "1.0.0",
    "type": "commonjs",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "build:frontend": "npm install --prefix .. && npm run build --prefix ..",
        "dev": "sh -c 'PORT_TO_CLEAR=${PORT:-5001}; IDS=$(lsof -ti tcp:${PORT_TO_CLEAR}); if [ -n \"$IDS\" ]; then kill $IDS; fi; nodemon server.js'",
        "seed": "node seed.js"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.18.2",
        "express-rate-limit": "^8.6.2",
        "jsonwebtoken": "^9.0.3",
        "mongodb-memory-server": "^11.1.0",
        "mongoose": "^8.3.2",
        "nodemailer": "^8.0.9"
    },
    "devDependencies": {
        "nodemon": "^3.1.0"
    }
}
